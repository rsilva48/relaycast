<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the icon in an indigo circle on the app's dark background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item android:width="112dp" android:height="112dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/launch_icon_background" />
        </shape>
    </item>
    <item android:width="168dp" android:height="168dp" android:gravity="center" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
