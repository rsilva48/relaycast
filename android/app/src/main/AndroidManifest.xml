<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Remote control while the app is closed: a service started at boot that
         opens the app when a phone sends an episode. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Phone: reminders of new episodes and the downloads' progress. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Phone: the translator app that shows a synopsis translation. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Google Play services checks that the Play Store is installed
             before it installs its modules (code scanner, ML Kit) or starts
             Cast. Stock GApps make the Play Store visible to every app; some
             builds don't (LineageOS with MindTheGApps on Android 11), and
             then everything fails with "requires the Google Play Store, but
             it is missing" / SERVICE_INVALID. -->
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gms" />
    </queries>

    <!-- Android TV app; it also installs on phones and tablets for testing. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Cleartext is allowed for relays on the home network (http://192.168.x.x). -->
    <application
        android:name=".RelaycastApp"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Relaycast"
        android:usesCleartextTraffic="true">

        <!-- Phone and tablet: Google Cast (Default Media Receiver). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="net.silvara.relaycast.CastOptionsProvider" />

        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the TV reachable from the user's phone remote through their own relay" />
        </service>

        <receiver android:name=".RemoteStartReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Phone: a TV's QR (profile or pairing) opened from the camera. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="relaycast" />
            </intent-filter>
        </activity>
        <!-- Phone: offline episodes (Media3 downloads, with a progress notification). -->
        <service
            android:name=".PhoneDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
