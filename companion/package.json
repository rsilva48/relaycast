{
  "name": "relaycast-companion",
  "version": "0.5.0",
  "productName": "Relaycast",
  "description": "Relaycast companion for Windows: installs and runs the Relaycast server and shares the videos on this PC with the apps.",
  "private": true,
  "main": "src/main.cjs",
  "author": "Relaycast",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "node --test",
    "dist": "npm run icon && npm run stage && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "net.silvara.relaycast.companion",
    "productName": "Relaycast",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/bin",
        "to": "bin"
      },
      {
        "from": "stage/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Relaycast-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "shortcutName": "Relaycast",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
