  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera scans the QR codes of your server, your profile or a TV, to set up the app or link the TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara escanea los códigos QR de tu servidor, de tu perfil o de una TV, para configurar la app o vincular la TV."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app connects to your shared folders and servers (SMB, SFTP, WebDAV and Relay Server) on your local network, and looks for Google Cast devices on your Wi‑Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se conecta a tus carpetas compartidas y servidores (SMB, SFTP, WebDAV y Relay Server) en tu red local, y busca dispositivos Google Cast en tu Wi‑Fi."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
