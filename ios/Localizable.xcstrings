      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The catalog needs internet. Downloaded episodes are still available in Downloads, and this list reloads by itself when the connection returns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
